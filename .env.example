# ==========================================
# CircuitGPT - Environment Configuration
# ==========================================

# General App Settings
APP_NAME=CircuitGPT
APP_ENV=development
DEBUG=true
SECRET_KEY=supersecretkeyreplaceinproductionvalue123!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=11520 # 8 days

# Ports & Hosts
FRONTEND_PORT=3000
BACKEND_PORT=8000
NGINX_PORT=80

# Database (PostgreSQL)
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_USER=circuitgpt
POSTGRES_PASSWORD=circuitsecurepass
POSTGRES_DB=circuitgpt_db

# Redis Cache & Sessions
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redissecurepass

# Vector Database (Qdrant)
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# Object Storage (MinIO)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadminsecure
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET_NAME=circuitgpt-bucket
MINIO_ENDPOINT=http://minio:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000

# AI/ML Provider Configuration (NVIDIA Nemotron Ultra)
LLM_PROVIDER=nvidia
NVIDIA_API_KEY=nvapi-your-nvidia-nim-api-key
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_REASONING_EFFORT=high
NVIDIA_MAX_TOKENS=16384
NVIDIA_TEMPERATURE=1.0
NVIDIA_TOP_P=0.95

# Context Window & RAG Settings
AI_CONTEXT_WINDOW_TOKENS=32000
AI_RAG_TOP_K=8
AI_MEMORY_TOP_K=5
AI_MAX_RECENT_MESSAGES=20

# Optional Auxiliary APIs
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile
TAVILY_API_KEY=your-tavily-api-key-here
DEEPGRAM_API_KEY=your-deepgram-api-key-here

# Next.js Public Vars
NEXT_PUBLIC_API_URL=http://localhost/api/v1
